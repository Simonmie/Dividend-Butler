{
  "name": "dividend-butler",
  "displayName": "红利管家 Beta",
  "description": "本地红利 ETF 定投模拟账本、分红预测与状态栏。",
  "version": "0.1.0-beta.1",
  "publisher": "local-dividend-butler",
  "license": "MIT",
  "engines": { "vscode": "^1.107.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      { "command": "dividendButler.open", "title": "红利管家：打开面板" },
      { "command": "dividendButler.refresh", "title": "红利管家：刷新公开数据" },
      { "command": "dividendButler.export", "title": "红利管家：导出本地备份" },
      { "command": "dividendButler.import", "title": "红利管家：恢复本地备份" }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:live": "node scripts/live.mjs",
    "test:host": "node scripts/host.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository -o releases/dividend-butler-0.1.0-beta.1.vsix",
    "vscode:prepublish": "npm run check && npm run build"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/vscode": "1.107.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  },
  "overrides": { "minimatch": "11.0.1" }
}
